{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "incremental": false,
    "rootDir": ".",
    "outDir": ".security-test-build",
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/rbac.ts",
    "lib/management/tenant-policy.ts",
    "lib/contractor-os/design-floor-plan.ts",
    "lib/menuboard/security.ts",
    "lib/menuboard/money.ts",
    "lib/menuboard/health.ts",
    "lib/menuboard/player-types.ts",
    "lib/menuboard/pairing-rate-limit.ts",
    "tests/security/**/*.ts",
    "tests/design-floor-plan.test.ts"
  ]
}
